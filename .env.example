# Copy to .env locally and replace every placeholder. Never commit .env.

# RunPod API access for Pod listing/provisioning.
RUNPOD_API_KEY=replace_with_runpod_api_key

# GitHub CLI/API access for publishing benchmark artifacts.
GITHUB_API_KEY=replace_with_github_token

# Optional local/remote workflow overrides.
RUNPOD_POD_ID=replace_with_pod_id
SSH_IDENTITY_FILE=/absolute/path/to/id_ed25519
GEMMA_REMOTE_ROOT=/workspace/gemma4-benchmark
GEMMA_HOURLY_RATE=0.69
